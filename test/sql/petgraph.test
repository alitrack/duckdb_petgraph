# name: test/sql/petgraph.test
# description: SQLLogicTest for duckdb_petgraph extension
# group: [petgraph]
# require petgraph_ext

# --------- Data management ---------
query IIII
SELECT * FROM petgraph_build_graph('g', '[(0,1,2.5),(1,2,1.0)]', 1)
----
g	3	2	1

query IIII
SELECT * FROM petgraph_list_graphs()
----
g	3	2	1

query II
SELECT * FROM petgraph_neighbors('@g', 0)
----
1	2.5

query II
SELECT * FROM petgraph_neighbors('@g', 1)
----
2	1.0

query II
SELECT * FROM petgraph_neighbors('@g', 2)
----

query III
SELECT * FROM petgraph_edges('@g')
----
0	1	2.5
1	2	1.0

# drop and verify
query II
SELECT * FROM petgraph_drop_graph('g')
----
g	1

query IIII
SELECT * FROM petgraph_list_graphs()
----

# drop non-existent
query II
SELECT * FROM petgraph_drop_graph('nonexistent')
----
nonexistent	0

# --------- Shortest path ---------
# inline edges
query IF
SELECT * FROM petgraph_shortest_path('[(0,1,2.5),(1,2,1.0),(0,2,5.0)]', 0, 2)
----
[0,1,2]	3.5

# unreachable
query IF
SELECT * FROM petgraph_shortest_path('[(0,1,2.5),(2,3,1.0)]', 0, 3)
----
[]	Infinity

# via cached graph
query IIII
SELECT * FROM petgraph_build_graph('sp', '[(0,1,2.5),(1,2,1.0),(0,2,5.0)]', 1)
----
sp	3	3	1

query IF
SELECT * FROM petgraph_shortest_path('@sp', 0, 2)
----
[0,1,2]	3.5

statement ok
SELECT * FROM petgraph_drop_graph('sp')

# --------- Connected Components ---------
query II
SELECT * FROM petgraph_connected_components('[(0,1,1),(1,2,1),(3,4,1)]')
----
0	0
1	0
2	0
3	1
4	1

# empty graph
query II
SELECT * FROM petgraph_connected_components('[]')
----

# --------- PageRank ---------
query IF
SELECT * FROM petgraph_pagerank('[(0,1,1),(1,2,1),(2,0,1)]', 0.85, 20)
----

# --------- Betweenness Centrality (undirected) ---------
query IF
SELECT * FROM petgraph_betweenness_centrality('[(0,1,1),(1,2,1),(0,2,1)]')
----

# --------- SCC ---------
query II
SELECT * FROM petgraph_scc('[(0,1,1),(1,2,1),(2,0,1),(3,0,1)]')
----

# --------- MST ---------
query IIF
SELECT * FROM petgraph_mst('[(0,1,5),(0,2,3),(1,2,1)]')
----

# --------- Closeness Centrality ---------
query IF
SELECT * FROM petgraph_closeness_centrality('[(0,1,1),(1,2,1),(0,2,1)]')
----

# --------- Eigenvector Centrality ---------
query IF
SELECT * FROM petgraph_eigenvector_centrality('[(0,1,1),(1,2,1),(2,0,1)]', 100, 1e-6)
----

# --------- Louvain ---------
query II
SELECT * FROM petgraph_louvain('[(0,1,1),(1,2,1),(3,4,1),(4,5,1)]')
----

# --------- Topological Sort ---------
query II
SELECT * FROM petgraph_toposort('[(0,1,1),(1,2,1),(0,2,1)]')
----
0	0
1	1
2	2

# --------- Is Cyclic ---------
query I
SELECT * FROM petgraph_is_cyclic('[(0,1,1),(1,2,1),(2,0,1)]')
----
1

query I
SELECT * FROM petgraph_is_cyclic('[(0,1,1),(1,2,1)]')
----
0

# --------- Undirected graph: multi-component algo ---------
query IIII
SELECT * FROM petgraph_build_graph('ug', '[(0,1,1),(1,2,1),(3,4,1)]', 0)
----
ug	5	3	0

query II
SELECT * FROM petgraph_connected_components('@ug')
----
0	0
1	0
2	0
3	1
4	1

statement ok
SELECT * FROM petgraph_drop_graph('ug')
